@model Invoice
@{ bool isEdit = Model.Id > 0; bool isAdmin = User.IsInRole("Admin"); }
<form method="post" style="max-width:650px">
    <input type="hidden" asp-for="Id" />
    @if (!isEdit)
    {
        <div class="mb-3"><label asp-for="StudentId" class="form-label"></label>
            <select asp-for="StudentId" asp-items="(SelectList)ViewBag.Students" class="form-select"><option value="0">-- select student --</option></select>
            <span asp-validation-for="StudentId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="FeeId" class="form-label"></label>
            <select asp-for="FeeId" asp-items="(SelectList)ViewBag.Fees" class="form-select"><option value="0">-- select fee --</option></select>
            <span asp-validation-for="FeeId" class="text-danger"></span></div>
    }
    else
    {
        <p class="text-muted">Invoice <strong>@Model.InvoiceNo</strong> &mdash; student and fee cannot be changed. Archive and re-issue if needed.</p>
    }
    @if (isAdmin)
    {
        <div class="mb-3"><label asp-for="DiscountId" class="form-label"></label>
            <select asp-for="DiscountId" asp-items="(SelectList)ViewBag.Discounts" class="form-select"><option value="">-- no discount --</option></select></div>
        <div class="mb-3"><label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" type="number" step="0.01" class="form-control" />
            <div class="form-text">@(isEdit ? "Discount is recalculated from this amount." : "Leave 0 to use the fee's default amount.")</div>
            <span asp-validation-for="Amount" class="text-danger"></span></div>
    }
    else
    {
        <p class="text-muted small">The standard fee amount is used. Ask an administrator if a custom amount or discount is needed.</p>
    }
    @if (isEdit)
    {
        <div class="mb-3"><label asp-for="LateFee" class="form-label"></label><input asp-for="LateFee" type="number" step="0.01" class="form-control" /></div>
    }
    <div class="row">
        <div class="col mb-3"><label asp-for="IssueDate" class="form-label"></label><input asp-for="IssueDate" type="date" class="form-control" /></div>
        <div class="col mb-3"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" type="date" class="form-control" /><span asp-validation-for="DueDate" class="text-danger"></span></div>
    </div>
    <div class="mb-3"><label asp-for="Installments" class="form-label"></label><input asp-for="Installments" type="number" min="1" max="12" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" /></div>
    <button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a>
</form>
