@model ProfileVM
@{ ViewData["Title"] = "My Profile"; }
<div class="d-flex justify-content-between"><div><h3>My Profile</h3><div class="text-muted">Update your account information.</div></div></div>
<div class="row g-3">
    <div class="col-lg-6">
        <form method="post" style="max-width:100%">
            <div class="mb-3"><label class="form-label">Username</label><input class="form-control" value="@Model.Username" disabled /></div>
            <div class="mb-3"><label class="form-label">Role</label><input class="form-control" value="@Model.Role" disabled /></div>
            <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@ucbanilad.edu.ph" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <button class="btn btn-primary">Save changes</button>
        </form>
    </div>
    <div class="col-lg-6">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold"><i class="bi bi-key me-1"></i> Password</h6>
            <p class="text-muted small">Change your password regularly to keep your account secure.</p>
            <a class="btn btn-outline-primary btn-sm" asp-action="ChangePassword">Change password</a>
        </div></div>
        <div class="card border-danger-subtle"><div class="card-body">
            <h6 class="fw-bold text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Danger zone</h6>
            <p class="text-muted small">Deleting your account is permanent and cannot be undone.</p>
            <a class="btn btn-outline-danger btn-sm" asp-action="DeleteAccount">Delete my account</a>
        </div></div>
    </div>
</div>
