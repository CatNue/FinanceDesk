@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string A(string c) => ctrl == c ? "active" : "";
    bool isAdmin = User.IsInRole("Admin");
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpper();
    var role = isAdmin ? "Administrator" : "Cashier";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - UC Banilad FinanceDesk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --bs-primary:#1e3a8a; --bs-primary-rgb:30,58,138; --bs-body-font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
                --navy:#0a1f44; --blue:#1e3a8a; --gold:#f5b301; --line:#e2e8f0; --muted:#64748b; --shadow:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04); }
        body { background:#f1f5f9; color:#1e293b; font-size:.92rem; }
        a { color:var(--blue); }

        /* ---------- Sidebar ---------- */
        .sidebar { position:fixed; top:0; bottom:0; left:0; width:255px; background:var(--navy); color:#cbd5e1; padding:1.25rem .9rem; overflow-y:auto; z-index:1040; transition:transform .25s; display:flex; flex-direction:column; }
        .brand { display:flex; align-items:center; gap:.75rem; color:#fff; text-decoration:none; font-weight:700; font-size:1.05rem; padding:.25rem .4rem 1rem; border-bottom:1px solid rgba(255,255,255,.08); margin-bottom:.5rem; }
        .brand:hover { color:#fff; }
        .brand small { display:block; font-weight:400; font-size:.7rem; color:#94a3b8; letter-spacing:.02em; }
        .brand-logo { width:42px; height:42px; border-radius:11px; background:linear-gradient(135deg,#fbbf24,#f5b301); display:grid; place-items:center; font-size:1.35rem; color:var(--navy); overflow:hidden; flex:none; }
        .brand-logo img { width:100%; height:100%; object-fit:contain; background:#fff; }
        .nav-label { font-size:.66rem; letter-spacing:.09em; text-transform:uppercase; color:#64748b; margin:1.1rem .6rem .4rem; font-weight:600; }
        .side-link { display:flex; align-items:center; gap:.7rem; padding:.58rem .75rem; border-radius:10px; color:#cbd5e1; text-decoration:none; font-size:.88rem; font-weight:500; margin-bottom:2px; }
        .side-link i { font-size:1.05rem; }
        .side-link:hover { background:rgba(255,255,255,.07); color:#fff; }
        .side-link.active { background:rgba(245,179,1,.14); color:#fbbf24; box-shadow:inset 3px 0 0 var(--gold); }
        .side-foot { margin-top:auto; padding:1rem .5rem 0; font-size:.72rem; color:#64748b; border-top:1px solid rgba(255,255,255,.08); }

        /* ---------- Layout ---------- */
        .main { margin-left:255px; min-height:100vh; }
        .topbar { display:flex; align-items:center; justify-content:space-between; padding:.7rem 2rem; background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:1030; }
        .content { padding:1.75rem 2rem 3rem; }
        .content h3 { font-size:1.45rem; font-weight:700; margin:0; color:var(--navy); letter-spacing:-.01em; }
        .content h5 { font-weight:600; font-size:1.05rem; margin:1.5rem 0 .75rem; color:var(--navy); }
        .content > .d-flex.justify-content-between { align-items:center; flex-wrap:wrap; gap:.75rem; margin-bottom:1.25rem !important; }
        .user-btn { display:flex; align-items:center; gap:.65rem; background:none; border:0; padding:.25rem .4rem; border-radius:12px; }
        .user-btn:hover { background:#f1f5f9; }
        .avatar { width:36px; height:36px; border-radius:50%; background:var(--blue); color:#fff; display:grid; place-items:center; font-weight:600; font-size:.8rem; }
        .u-name { display:block; font-weight:600; font-size:.83rem; line-height:1.1; color:var(--navy); }
        .u-role { display:block; font-size:.7rem; color:var(--muted); }

        /* ---------- Cards, tables ---------- */
        .card { border:0; border-radius:14px; box-shadow:var(--shadow); }
        .card-header { background:#fff; border-bottom:1px solid var(--line); font-weight:600; border-radius:14px 14px 0 0 !important; padding:.9rem 1.1rem; color:var(--navy); }
        .table-card { background:#fff; border-radius:14px; box-shadow:var(--shadow); overflow:hidden; margin-bottom:1rem; }
        .table-card .table { margin:0; --bs-table-bg:transparent; }
        .table > :not(caption) > * > * { padding:.8rem 1rem; border-bottom-color:#f1f5f9; vertical-align:middle; }
        .table thead th { background:#f8fafc; text-transform:uppercase; font-size:.7rem; letter-spacing:.05em; color:var(--muted); font-weight:600; border-bottom:1px solid var(--line); white-space:nowrap; }
        .table-striped > tbody > tr:nth-of-type(odd) > * { --bs-table-accent-bg:transparent; }
        .table tbody tr:hover > * { background:#f8fafc; }
        .table .empty { text-align:center; color:#94a3b8; padding:2.5rem 1rem !important; }
        .table .empty i { font-size:2rem; display:block; }

        /* ---------- Forms & buttons ---------- */
        .form-control,.form-select { border-radius:10px; border-color:#cbd5e1; padding:.55rem .8rem; }
        .form-control:focus,.form-select:focus { border-color:#1e3a8a; box-shadow:0 0 0 .2rem rgba(30,58,138,.15); }
        .form-label { font-weight:600; font-size:.82rem; color:#334155; }
        form[style*="max-width"] { background:#fff; padding:1.5rem; border-radius:14px; box-shadow:var(--shadow); }
        .btn { border-radius:10px; font-weight:500; } .btn-sm { border-radius:8px; }
        .btn-primary { --bs-btn-bg:#1e3a8a; --bs-btn-border-color:#1e3a8a; --bs-btn-hover-bg:#172f6f; --bs-btn-hover-border-color:#172f6f; --bs-btn-active-bg:#12265a; --bs-btn-active-border-color:#12265a; }
        .btn-outline-primary { --bs-btn-color:#1e3a8a; --bs-btn-border-color:#c7d2fe; --bs-btn-hover-bg:#1e3a8a; --bs-btn-hover-border-color:#1e3a8a; --bs-btn-active-bg:#172f6f; --bs-btn-active-border-color:#172f6f; }
        .btn-outline-secondary { --bs-btn-border-color:#cbd5e1; }
        .btn-gold { background:var(--gold); border-color:var(--gold); color:var(--navy); font-weight:600; } .btn-gold:hover { background:#e0a400; border-color:#e0a400; color:var(--navy); }

        /* ---------- Status pills ---------- */
        .pill,.badge { display:inline-block; padding:.28rem .7rem; border-radius:999px; font-size:.74rem; font-weight:600; }
        .pill-green,.badge.bg-success { background:#dcfce7 !important; color:#166534 !important; }
        .pill-amber,.badge.bg-warning { background:#fef3c7 !important; color:#92400e !important; }
        .pill-red,.badge.bg-danger { background:#fee2e2 !important; color:#991b1b !important; }
        .pill-slate,.badge.bg-secondary { background:#e2e8f0 !important; color:#475569 !important; }
        .pill-blue { background:#dbeafe; color:#1e3a8a; }

        /* ---------- Dashboard pieces ---------- */
        .hero-banner { border-radius:16px; padding:1.5rem 1.75rem; color:#fff; margin-bottom:1.25rem; position:relative; overflow:hidden;
                       background:radial-gradient(circle at 90% 20%, rgba(245,179,1,.25), transparent 45%), linear-gradient(120deg,#0a1f44,#1e3a8a); }
        .hero-banner h3 { color:#fff; } .hero-banner .sub { color:#c7d2ee; }
        .stat { background:#fff; border-radius:14px; padding:1.1rem 1.25rem; display:flex; gap:1rem; align-items:center; box-shadow:var(--shadow); height:100%; }
        .stat-icon { width:48px; height:48px; border-radius:12px; display:grid; place-items:center; font-size:1.4rem; flex:none; }
        .stat-label { font-size:.76rem; color:var(--muted); font-weight:500; }
        .stat-value { font-size:1.35rem; font-weight:700; line-height:1.2; color:var(--navy); }
        .stat-sub { font-size:.73rem; color:var(--muted); }
        .ic-red { background:#fee2e2; color:#dc2626; } .ic-amber { background:#fef3c7; color:#d97706; }
        .ic-green { background:#dcfce7; color:#16a34a; } .ic-blue { background:#dbeafe; color:#1e3a8a; }
        .quick { display:flex; align-items:center; gap:.75rem; padding:.9rem 1rem; border-radius:12px; background:#fff; box-shadow:var(--shadow); text-decoration:none; color:var(--navy); font-weight:600; transition:transform .15s, box-shadow .15s; height:100%; }
        .quick:hover { transform:translateY(-2px); box-shadow:0 6px 16px rgba(15,23,42,.10); color:var(--blue); }
        .quick i { font-size:1.3rem; color:var(--blue); background:#eff6ff; width:42px; height:42px; display:grid; place-items:center; border-radius:10px; }
        .quick small { display:block; font-weight:400; color:var(--muted); font-size:.74rem; }
        .quick.big { padding:1.25rem; } .quick.big i { background:var(--gold); color:var(--navy); width:52px; height:52px; font-size:1.5rem; }

        @@media (max-width: 991px) {
            .sidebar { transform:translateX(-100%); } .sidebar.open { transform:none; }
            .main { margin-left:0; } .content { padding:1rem; } .topbar { padding:.7rem 1rem; }
        }
        @@media print {
            .sidebar,.topbar,.no-print,.toast-container { display:none !important; }
            .main { margin-left:0; } .content { padding:0; } body { background:#fff; }
        }
    </style>
</head>
<body>
<aside class="sidebar no-print" id="sidebar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <span class="brand-logo"><img src="~/images/uc-logo.png" alt="" onerror="this.remove()" onload="this.nextElementSibling.style.display='none'" /><i class="bi bi-mortarboard-fill"></i></span>
        <span>UC FinanceDesk<small>University of Cebu &middot; Banilad</small></span>
    </a>
    <nav>
        <div class="nav-label">Overview</div>
        <a class="side-link @A("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>

        <div class="nav-label">Billing</div>
        <a class="side-link @A("Invoices")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Invoices</a>
        <a class="side-link @A("Payments")" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i> Payments</a>
        <a class="side-link @A("Receipts")" asp-controller="Receipts" asp-action="Index"><i class="bi bi-receipt"></i> Receipts</a>
        <a class="side-link @A("Overdue")" asp-controller="Overdue" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> Overdue</a>

        <div class="nav-label">Records</div>
        <a class="side-link @A("Students")" asp-controller="Students" asp-action="Index"><i class="bi bi-people"></i> Students</a>
        @if (isAdmin)
        {
            <a class="side-link @A("Fees")" asp-controller="Fees" asp-action="Index"><i class="bi bi-tags"></i> Fees</a>
            <a class="side-link @A("Discounts")" asp-controller="Discounts" asp-action="Index"><i class="bi bi-percent"></i> Discounts</a>

            <div class="nav-label">Administration</div>
            <a class="side-link @A("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Reports</a>
            <a class="side-link @A("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> User Accounts</a>
            <a class="side-link @A("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-clipboard-data"></i> Audit Log</a>
        }
    </nav>
    <div class="side-foot">Finance Office<br />Gov. M. Cuenco Ave., Banilad, Cebu City</div>
</aside>

<div class="main">
    <header class="topbar no-print">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light d-lg-none" id="menuBtn" type="button"><i class="bi bi-list"></i></button>
            <div class="d-none d-md-block"><div class="fw-semibold" style="color:var(--navy)">University of Cebu &ndash; Banilad Campus</div><div class="text-muted small">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</div></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-outline-primary btn-sm d-none d-sm-inline-block" asp-controller="Invoices" asp-action="Create"><i class="bi bi-plus-lg"></i> New Invoice</a>
            <a class="btn btn-primary btn-sm" asp-controller="Payments" asp-action="Create"><i class="bi bi-cash-coin"></i> Record Payment</a>
            <div class="dropdown ms-2">
                <button class="user-btn" data-bs-toggle="dropdown" type="button">
                    <span class="avatar">@initials</span>
                    <span class="d-none d-md-block text-start"><span class="u-name">@fullName</span><span class="u-role">@role</span></span>
                    <i class="bi bi-chevron-down small text-muted"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:12px">
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My profile</a></li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button></form></li>
                </ul>
            </div>
        </div>
    </header>
    <main class="content">
        @RenderBody()
    </main>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3 no-print" style="z-index:2000">
    @if (TempData["Msg"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body"><i class="bi bi-check-circle me-2"></i>@TempData["Msg"]</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0" role="alert"><div class="d-flex"><div class="toast-body"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Err"]</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
    }
</div>

<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:16px">
            <div class="modal-body text-center p-4">
                <div class="mb-2" style="font-size:2.2rem;color:#f59e0b"><i class="bi bi-exclamation-triangle"></i></div>
                <h6 class="fw-bold">Please confirm</h6>
                <p class="text-muted mb-3" id="confirmText">Are you sure?</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger" id="confirmYes">Yes, continue</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var sb = document.getElementById('sidebar');
    document.getElementById('menuBtn').addEventListener('click', function () { sb.classList.toggle('open'); });
    document.querySelectorAll('.toast').forEach(function (t) { new bootstrap.Toast(t, { delay: 4500 }).show(); });

    document.querySelectorAll('.content table.table').forEach(function (t) {
        if (t.closest('.card') || t.closest('.table-card')) return;
        var w = document.createElement('div');
        w.className = 'table-card table-responsive';
        t.parentNode.insertBefore(w, t);
        w.appendChild(t);
        var tb = t.tBodies[0];
        if (tb && tb.rows.length === 0) {
            var cols = t.tHead ? t.tHead.rows[0].cells.length : 1;
            tb.innerHTML = '<tr><td colspan="' + cols + '" class="empty"><i class="bi bi-inbox"></i>No records yet</td></tr>';
        }
    });

    var map = { Paid:'green', Reconciled:'green', Yes:'green', Sent:'green', Active:'green', Created:'green', Login:'slate', Logout:'slate',
                Partial:'amber', Flagged:'amber', Updated:'blue', Overdue:'red', Deleted:'red', LoginFailed:'red', Inactive:'slate',
                Unpaid:'slate', No:'slate', Admin:'blue', Cashier:'slate' };
    document.querySelectorAll('.content td').forEach(function (td) {
        var txt = td.textContent.trim();
        if (map[txt] && td.children.length === 0) td.innerHTML = '<span class="pill pill-' + map[txt] + '">' + txt + '</span>';
    });

    var modal = new bootstrap.Modal(document.getElementById('confirmModal')), pending = null;
    document.querySelectorAll('form[onsubmit*="confirm("]').forEach(function (f) {
        var m = (f.getAttribute('onsubmit').match(/confirm\('([^']*)'\)/) || [])[1] || 'Are you sure?';
        f.removeAttribute('onsubmit');
        f.addEventListener('submit', function (e) { e.preventDefault(); pending = f; document.getElementById('confirmText').textContent = m; modal.show(); });
    });
    document.getElementById('confirmYes').addEventListener('click', function () { if (pending) { modal.hide(); pending.submit(); } });
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
