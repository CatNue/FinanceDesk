@model List<Student>
@{ ViewData["Title"] = "Students"; }
<div class="d-flex justify-content-between mb-3"><h3>Students</h3><a class="btn btn-primary" asp-action="Create">+ New Student</a></div>
<form class="row g-2 mb-3"><div class="col-auto"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name / no. / grade" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form>
<table class="table table-striped bg-white">
    <thead><tr><th>Student No.</th><th>Name</th><th>Grade</th><th>Email</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model) {
        <tr><td>@s.StudentNo</td><td>@s.FullName</td><td>@s.GradeLevel</td><td>@s.Email</td><td>@s.Phone</td>
        <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@s.Id">History</a>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
            @if (User.IsInRole("Admin"))
            {
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this student?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
            }
        </td></tr>
    }
    </tbody>
</table>
