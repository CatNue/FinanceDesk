@model Discount
<form method="post" style="max-width:600px">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select"><option value="Percentage">Percentage (%)</option><option value="Fixed">Fixed amount</option></select></div>
    <div class="mb-3"><label asp-for="Value" class="form-label"></label><input asp-for="Value" type="number" step="0.01" class="form-control" /><span asp-validation-for="Value" class="text-danger"></span></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a>
</form>
