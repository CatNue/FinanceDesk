@model List<Payment>
@{ ViewData["Title"] = "Reports"; var from = (DateTime)ViewBag.From; var to = (DateTime)ViewBag.To; }
<h3 class="mb-3">Financial Reports</h3>
<form class="row g-2 mb-3 no-print">
    <div class="col-auto"><label class="form-label mb-0">From</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><label class="form-label mb-0">To</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto align-self-end"><button class="btn btn-outline-secondary">Apply</button></div>
    <div class="col-auto align-self-end">
        <a class="btn btn-success" asp-action="ExportPayments" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")">Export Collections (Excel)</a>
        <a class="btn btn-success" asp-action="ExportOutstanding">Export Outstanding (Excel)</a>
        <button type="button" class="btn btn-danger" onclick="window.print()">Save as PDF / Print</button>
    </div>
</form>
<p class="text-muted">Period: @from.ToString("MMM dd, yyyy") &ndash; @to.ToString("MMM dd, yyyy")</p>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card"><div class="card-body">Collections<div class="h4 text-success">@Model.Sum(p => p.Amount).Money()</div>@Model.Count payment(s)</div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">Billed in period<div class="h4">@(((decimal)ViewBag.Billed).Money())</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">Total outstanding (today)<div class="h4 text-danger">@(((decimal)ViewBag.Outstanding).Money())</div></div></div></div>
</div>
<div class="row g-3">
    <div class="col-md-6">
        <h5>By Day</h5>
        <table class="table table-sm bg-white"><thead><tr><th>Date</th><th>Count</th><th class="text-end">Total</th></tr></thead><tbody>
        @foreach (var g in Model.GroupBy(p => p.PaymentDate.Date).OrderBy(g => g.Key)) {
            <tr><td>@g.Key.ToString("yyyy-MM-dd")</td><td>@g.Count()</td><td class="text-end">@g.Sum(p => p.Amount).Money()</td></tr>
        }</tbody></table>
    </div>
    <div class="col-md-6">
        <h5>By Method</h5>
        <table class="table table-sm bg-white"><thead><tr><th>Method</th><th>Count</th><th class="text-end">Total</th></tr></thead><tbody>
        @foreach (var g in Model.GroupBy(p => p.Method).OrderByDescending(g => g.Sum(p => p.Amount))) {
            <tr><td>@g.Key</td><td>@g.Count()</td><td class="text-end">@g.Sum(p => p.Amount).Money()</td></tr>
        }</tbody></table>
    </div>
</div>
<h5 class="mt-3">All Payments in Period</h5>
<table class="table table-sm table-striped bg-white">
    <thead><tr><th>Date</th><th>Student</th><th>Invoice</th><th>Method</th><th>Reference</th><th class="text-end">Amount</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var p in Model) {
        <tr><td>@p.PaymentDate.ToString("yyyy-MM-dd")</td><td>@p.Invoice.Student.FullName</td><td>@p.Invoice.InvoiceNo</td><td>@p.Method</td><td>@p.ReferenceNo</td><td class="text-end">@p.Amount.Money()</td><td>@p.Status</td></tr>
    }
    </tbody>
</table>
