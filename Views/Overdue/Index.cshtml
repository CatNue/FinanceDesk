@model List<Invoice>
@{ ViewData["Title"] = "Overdue"; }
<div class="d-flex justify-content-between mb-3">
    <h3>Overdue Invoices</h3>
    <div>
        <form asp-action="ApplyAllLateFees" method="post" class="d-inline" onsubmit="return confirm('Apply @ViewBag.Pct% late fee to all overdue invoices without one?')"><button class="btn btn-warning">Apply Late Fees to All (@ViewBag.Pct%)</button></form>
        <form asp-action="RemindAll" method="post" class="d-inline"><button class="btn btn-primary">Email Reminder to All</button></form>
    </div>
</div>
<table class="table table-striped bg-white">
    <thead><tr><th>Invoice</th><th>Student</th><th>Contact</th><th>Due</th><th>Days Late</th><th class="text-end">Late Fee</th><th class="text-end">Balance</th><th></th></tr></thead>
    <tbody>
    @foreach (var i in Model) {
        <tr><td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@i.Id">@i.InvoiceNo</a></td><td>@i.Student.FullName</td>
        <td>@i.Student.Email<br />@i.Student.Phone</td><td>@i.DueDate.ToString("yyyy-MM-dd")</td><td>@((DateTime.Today - i.DueDate.Date).Days)</td>
        <td class="text-end">@i.LateFee.Money()</td><td class="text-end text-danger">@i.Balance.Money()</td>
        <td class="text-end text-nowrap">
            <form asp-action="ApplyLateFee" asp-route-id="@i.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-warning" disabled="@(i.LateFee > 0)">Late Fee</button></form>
            <form asp-action="Remind" asp-route-id="@i.Id" asp-route-channel="Email" method="post" class="d-inline"><button class="btn btn-sm btn-outline-primary">Email</button></form>
            <form asp-action="Remind" asp-route-id="@i.Id" asp-route-channel="SMS" method="post" class="d-inline"><button class="btn btn-sm btn-outline-info">SMS</button></form>
        </td></tr>
    }
    </tbody>
</table>
<h5 class="mt-4">Recent reminders</h5>
<table class="table table-sm bg-white">
    <thead><tr><th>Sent</th><th>Invoice</th><th>Student</th><th>Channel</th><th>Result</th></tr></thead>
    <tbody>
    @foreach (var l in (List<ReminderLog>)ViewBag.Logs) {
        <tr><td>@l.SentAt.ToString("yyyy-MM-dd HH:mm")</td><td>@l.Invoice.InvoiceNo</td><td>@l.Invoice.Student.FullName</td><td>@l.Channel</td><td>@l.Result</td></tr>
    }
    </tbody>
</table>
